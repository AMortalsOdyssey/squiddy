page {
  background: #f6f3eb;
  color: #24332b;
  font-family: -apple-system, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
.page {
  padding: 40rpx;
}
.eyebrow {
  font-size: 24rpx;
  color: #657168;
}
.title {
  font-size: 52rpx;
  font-weight: 600;
  margin: 16rpx 0 32rpx;
}
.hero {
  background: #244b3b;
  color: #fffefa;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 600;
}
.card {
  background: #fffefa;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 0;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.muted {
  color: #657168;
  font-size: 26rpx;
}
.dish-name {
  font-size: 32rpx;
  font-weight: 600;
}
.tag {
  background: rgba(36, 75, 59, 0.07);
  color: #244b3b;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.primary {
  background: #244b3b;
  color: #fffefa;
  border-radius: 24rpx;
  margin-top: 32rpx;
  font-size: 28rpx;
}
.secondary {
  background: #fffefa;
  color: #244b3b;
  font-size: 28rpx;
  border-radius: 24rpx;
  margin-top: 24rpx;
}
.note {
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(190, 99, 69, 0.1);
  color: #be6345;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.4;
}
.step {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.step button {
  width: 80rpx;
  padding: 0;
  margin: 0;
  font-size: 36rpx;
  color: #244b3b;
  background: #f6f3eb;
  min-height: 88rpx;
  line-height: 88rpx;
}
.field {
  width: 100%;
  padding: 20rpx 0;
  min-height: 120rpx;
}

.local-banner {
  font-size: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(190, 99, 69, 0.1);
  color: #be6345;
  margin-bottom: 28rpx;
}
.empty {
  padding: 64rpx 20rpx;
  text-align: center;
  color: #657168;
}
.hero-copy {
  margin-top: 20rpx;
  opacity: 0.8;
}
.cream-button {
  background: #fffefa;
  color: #244b3b;
  font-size: 28rpx;
  margin-top: 32rpx;
  border-radius: 20rpx;
}
.link-button {
  background: transparent;
  color: #244b3b;
  font-size: 24rpx;
  padding: 12rpx 8rpx;
  margin: 0;
  line-height: 1.8;
  flex-shrink: 0;
}
.hero-link {
  background: transparent;
  color: #fffefa;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 48rpx 0 20rpx;
}
.label {
  color: #657168;
  font-size: 26rpx;
  margin: 12rpx 0;
}
.input {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(36, 75, 59, 0.12);
  font-size: 28rpx;
  min-height: 48rpx;
}
.textarea {
  min-height: 180rpx;
  width: 100%;
  padding: 16rpx 0;
  font-size: 28rpx;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(36, 75, 59, 0.08);
}
.form-row:last-child {
  border-bottom: 0;
}
.flex {
  flex: 1;
  min-width: 0;
}
.row .primary,
.row .secondary {
  margin: 0;
}
.compact {
  padding: 24rpx 28rpx;
}
.internal {
  font-size: 22rpx;
  color: #657168;
  text-align: right;
}
.internal view {
  font-size: 28rpx;
  color: #244b3b;
}
.text-danger {
  margin: 36rpx 0;
  background: transparent;
  color: #be6345;
  font-size: 26rpx;
}
.inverse {
  color: #fffefa;
  opacity: 0.7;
}
.sticky-action {
  margin-bottom: 36rpx;
}
.page {
  padding-bottom: 64rpx;
}
