.photo-picker {
  height: 320rpx;
  border-radius: 28rpx;
  background: rgba(36, 75, 59, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}
.photo-picker image {
  width: 100%;
  height: 100%;
}
.number-input {
  max-width: 160rpx;
  text-align: right;
}
.tall {
  min-height: 320rpx;
}
