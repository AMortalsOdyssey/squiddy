.photo-picker {
  height: 200rpx;
  border-radius: 18rpx;
  background: rgba(36, 75, 59, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}
.photo-picker image {
  width: 100%;
  height: 100%;
}
.number-input {
  max-width: 160rpx;
  text-align: center;
}
.tall {
  min-height: 200rpx;
  height: 200rpx;
}

.draft-note {
  color: rgba(36, 51, 43, 0.62);
  font-size: 22rpx;
  padding: 12rpx 0;
}
