.kitchen-header {
  padding: 8rpx 0 16rpx;
}
.kitchen-header .title {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}
.edit-kitchen {
  margin: 8rpx 0 0;
  padding-left: 0;
}
.kitchen-actions {
  margin: 8rpx 0 20rpx;
}
.kitchen-actions .primary,
.kitchen-actions .secondary {
  font-size: 24rpx;
}
.management-search {
  height: 68rpx;
  padding: 0 16rpx;
  background: #fffefa;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.filter-row {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 0;
}
.filter-chip {
  padding: 12rpx 16rpx;
  min-height: 64rpx;
  color: rgba(36, 51, 43, 0.6);
  font-size: 23rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}
.filter-chip.active {
  background: rgba(36, 75, 59, 0.07);
  color: #244b3b;
  font-weight: 600;
}
.recipe-management-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  background: #fffefa;
  border-radius: 16rpx;
  margin: 12rpx 0;
}
.recipe-mini {
  width: 64rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: rgba(36, 75, 59, 0.05);
  color: #244b3b;
  font-size: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.recipe-price {
  color: rgba(36, 51, 43, 0.6);
  font-size: 21rpx;
  margin-top: 8rpx;
}
.recipe-state {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.inactive-tag {
  color: rgba(36, 51, 43, 0.5);
  background: rgba(36, 51, 43, 0.04);
}
.member-card {
  padding: 4rpx 16rpx;
}
.member-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: rgba(36, 75, 59, 0.06);
  color: #244b3b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}
.cover-preview {
  width: 100%;
  height: 260rpx;
  border-radius: 14rpx;
  margin: 14rpx 0;
}
.kitchen-leave {
  margin-top: 40rpx;
  border-top: 1rpx solid rgba(36, 75, 59, 0.08);
}
