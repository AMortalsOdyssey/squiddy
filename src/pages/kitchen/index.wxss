.kitchen-header {
  padding: 8rpx 0 24rpx;
}
.kitchen-header .title {
  font-size: 46rpx;
  margin-bottom: 16rpx;
}
.edit-kitchen {
  margin: 12rpx 0 0;
  padding-left: 0;
}
.kitchen-actions {
  margin: 12rpx 0 28rpx;
}
.kitchen-actions .primary,
.kitchen-actions .secondary {
  font-size: 26rpx;
}
.management-search {
  height: 88rpx;
  padding: 0 24rpx;
  background: #fffefa;
  border-radius: 18rpx;
  font-size: 26rpx;
}
.filter-row {
  display: flex;
  gap: 8rpx;
  padding: 16rpx 0;
}
.filter-chip {
  padding: 18rpx 22rpx;
  min-height: 88rpx;
  color: rgba(36, 51, 43, 0.6);
  font-size: 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}
.filter-chip.active {
  background: rgba(36, 75, 59, 0.07);
  color: #244b3b;
  font-weight: 600;
}
.recipe-management-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #fffefa;
  border-radius: 22rpx;
  margin: 16rpx 0;
}
.recipe-mini {
  width: 88rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(36, 75, 59, 0.05);
  color: #244b3b;
  font-size: 38rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.recipe-price {
  color: rgba(36, 51, 43, 0.6);
  font-size: 21rpx;
  margin-top: 8rpx;
}
.recipe-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.inactive-tag {
  color: rgba(36, 51, 43, 0.5);
  background: rgba(36, 51, 43, 0.04);
}
.member-card {
  padding: 4rpx 24rpx;
}
.member-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(36, 75, 59, 0.06);
  color: #244b3b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.cover-preview {
  width: 100%;
  height: 260rpx;
  border-radius: 20rpx;
  margin: 20rpx 0;
}
.kitchen-leave {
  margin-top: 56rpx;
  border-top: 1rpx solid rgba(36, 75, 59, 0.08);
}
