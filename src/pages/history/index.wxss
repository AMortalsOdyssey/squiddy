.kitchen-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: #fffefa;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.history-summary {
  display: flex;
  gap: 80rpx;
  padding: 24rpx 8rpx;
}
.history-number {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #244b3b;
  margin-bottom: 8rpx;
}
.history-summary .muted {
  font-size: 22rpx;
}
.history-search {
  height: 68rpx;
  background: #fffefa;
  padding: 0 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.history-card {
  background: #fffefa;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 14rpx 0;
}
.history-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  margin-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(36, 75, 59, 0.08);
  font-size: 22rpx;
  color: rgba(36, 51, 43, 0.62);
}
.history-card .dish-name {
  margin-bottom: 8rpx;
}
