<view class="page history-page"><view class="eyebrow">每一顿，都值得记得。</view><view class="title">一起吃过的饭</view><picker wx:if="{{kitchens.length}}" mode="selector" range="{{kitchens}}" range-key="name" value="{{kitchenIndex}}" bindchange="switchKitchen"><view class="kitchen-picker"><text>{{kitchens[kitchenIndex].name}}</text><text class="muted">换厨房⌄</text></view></picker><view class="history-summary"><view><view class="history-number">{{meals.length}}</view><view class="muted">顿饭的记录</view></view><view><view class="history-number">{{activeCount}}</view><view class="muted">顿正在安排</view></view></view><input class="history-search" placeholder="搜索饭局名称或日期" value="{{search}}" bindinput="search"/><view class="segmented"><view class="segment {{filter==='all'?'active':''}}" data-filter="all" bindtap="filter">全部</view><view class="segment {{filter==='active'?'active':''}}" data-filter="active" bindtap="filter">进行中</view><view class="segment {{filter==='ended'?'active':''}}" data-filter="ended" bindtap="filter">已结束</view></view><view wx:if="{{loading}}" class="empty">正在翻看每一顿的记录…</view><view wx:elif="{{error}}" class="card"><view>{{error}}</view><button class="secondary" bindtap="refresh">重新加载</button></view><view wx:elif="{{!visible.length}}" class="empty"><view class="empty-title">{{meals.length?'还没有这样的记录':'第一顿饭，从今天开始'}}</view><view>{{meals.length?'换个关键词或筛选条件试试。':'做几道喜欢的菜，约在意的人吃饭。'}}</view></view><view wx:else class="history-list"><view class="history-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="history-date"><text>{{item.when}}</text><text class="tag">{{item.label}}</text></view><view class="row"><view class="flex"><view class="dish-name">{{item.title}}</view><view class="muted">{{item.estimated_people}} 人的相聚<text wx:if="{{item.id===currentId}}"> · 当前饭局</text></view></view><text class="chevron">›</text></view></view></view><button wx:if="{{!loading && (!kitchens.length||kitchens[kitchenIndex].role!=='member')}}" class="primary" bindtap="create">再约一顿饭</button></view>
