.feedback-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0;
}
.page .feedback-tag {
  width: auto;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1.4;
  padding: 12rpx 16rpx;
  margin: 0;
  border-radius: 12rpx;
  background: rgba(36, 75, 59, 0.06);
  color: #244b3b;
}
.feedback-tag.selected {
  background: #244b3b;
  color: #fffefa;
}
.short-note {
  min-height: 100rpx;
}
.friend-line {
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(36, 75, 59, 0.1);
}
.review-note {
  margin: 12rpx 0 20rpx;
}
