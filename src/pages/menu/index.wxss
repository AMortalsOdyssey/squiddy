.brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.brand-row .brand-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
}
.brand-name {
  font-size: 28rpx;
  font-weight: 600;
}
.brand-row .eyebrow {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  margin: 2rpx 0 0;
}
.menu-title {
  font-size: 46rpx;
  margin-bottom: 24rpx;
}
.kitchen-context {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.context-name {
  font-size: 27rpx;
  font-weight: 600;
}
.kitchen-context .muted {
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.kitchen-cover {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}
.meal-card {
  background: #244b3b;
  color: #fffefa;
  padding: 28rpx;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
}
.meal-overline {
  color: rgba(255, 254, 250, 0.68);
  font-size: 22rpx;
}
.meal-status {
  color: #fffefa;
  background: rgba(255, 254, 250, 0.12);
  border-radius: 10rpx;
  padding: 6rpx 12rpx;
  font-size: 22rpx;
}
.meal-name {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  margin: 16rpx 0 12rpx;
}
.meal-time {
  font-size: 26rpx;
}
.meal-cutoff {
  color: rgba(255, 254, 250, 0.68);
  font-size: 21rpx;
  margin-top: 4rpx;
}
.meal-switch {
  width: auto;
  margin: 0;
  padding: 12rpx 0 12rpx 16rpx;
  color: #fffefa;
  background: transparent;
  font-size: 23rpx;
  flex-shrink: 0;
}
.search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: #fffefa;
  margin: 24rpx 0 20rpx;
}
.search-symbol {
  color: rgba(36, 51, 43, 0.5);
  font-size: 38rpx;
}
.search {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  height: 88rpx;
}
.categories {
  white-space: nowrap;
  margin-bottom: 24rpx;
  width: 100%;
}
.category {
  display: inline-block;
  padding: 18rpx 24rpx;
  min-height: 88rpx;
  margin-right: 8rpx;
  border-radius: 18rpx;
  color: rgba(36, 51, 43, 0.65);
  font-size: 26rpx;
}
.category.selected {
  background: #244b3b;
  color: #fffefa;
  font-weight: 600;
}
.recommend-button {
  width: 100%;
  display: flex;
  gap: 18rpx;
  text-align: left;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(36, 75, 59, 0.06);
  margin: 0 0 28rpx;
}
.recommend-icon {
  width: 64rpx;
  height: 64rpx;
  background: #fffefa;
  color: #244b3b;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.recommend-title {
  color: #244b3b;
  font-size: 27rpx;
  font-weight: 600;
}
.recommend-button .muted {
  font-size: 21rpx;
  margin-top: 4rpx;
}
.dish-card {
  display: flex;
  gap: 24rpx;
  background: #fffefa;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}
.dish-image,
.dish-placeholder {
  width: 160rpx;
  height: 184rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}
.dish-placeholder {
  background: rgba(36, 75, 59, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #244b3b;
  gap: 10rpx;
}
.dish-initial {
  font-size: 50rpx;
  font-weight: 500;
}
.dish-category {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.6;
}
.dish-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12rpx;
}
.dish-content .muted {
  font-size: 23rpx;
  margin-top: 4rpx;
}
.dish-content .step {
  gap: 8rpx;
}
.dish-content .step button {
  width: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
}
.recipe-link {
  color: #244b3b;
  font-size: 24rpx;
  padding: 16rpx 0;
}
.dock-arrow {
  margin-left: 12rpx;
}
.welcome-card {
  background: #fffefa;
  padding: 36rpx;
  border-radius: 28rpx;
}
.welcome-illustration {
  padding: 48rpx 0;
  margin: 0 0 28rpx;
  text-align: center;
  background: rgba(36, 75, 59, 0.05);
  border-radius: 20rpx;
  color: #244b3b;
  font-size: 38rpx;
  letter-spacing: 12rpx;
}
.welcome-card .hero-title {
  font-size: 44rpx;
  margin-bottom: 20rpx;
}

.menu-page .brand-row {
  margin-bottom: 20rpx;
}
.menu-page .meal-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.menu-page .meal-name {
  font-size: 34rpx;
  margin: 12rpx 0 10rpx;
}
.menu-page .meal-overline {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.menu-page .search-wrap {
  margin: 20rpx 0 12rpx;
}
.menu-page .categories {
  margin-bottom: 16rpx;
}
.page button.recommend-button {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.menu-page .recommend-title {
  font-size: 25rpx;
}
.menu-page .recommend-icon {
  width: 56rpx;
  height: 56rpx;
}
.menu-page .section-head {
  margin-top: 24rpx;
}
