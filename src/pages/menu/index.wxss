.search-wrap {
  margin: 32rpx 0 20rpx;
}
.search {
  background: #fffefa;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}
.categories {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.category {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 40rpx;
  color: #657168;
  background: #fffefa;
}
.category.selected {
  background: #244b3b;
  color: #fffefa;
}
.meal-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0 24rpx;
}
.dish-card {
  display: flex;
  gap: 24rpx;
  background: #fffefa;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}
.dish-image,
.dish-placeholder {
  width: 160rpx;
  height: 176rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}
.dish-placeholder {
  background: rgba(36, 75, 59, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #244b3b;
  font-size: 32rpx;
  letter-spacing: 8rpx;
}
.dish-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.dish-content .step {
  justify-content: flex-end;
}
.dish-content .step button {
  width: 64rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 32rpx;
}
.recommend-button {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(36, 75, 59, 0.07);
  color: #244b3b;
  font-size: 28rpx;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 46rpx;
}
