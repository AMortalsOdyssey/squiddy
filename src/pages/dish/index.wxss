.dish-detail {
  padding-top: 24rpx;
}
.recipe-cover {
  width: 100%;
  height: 400rpx;
  border-radius: 28rpx;
  display: block;
}
.recipe-placeholder {
  background: rgba(36, 75, 59, 0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #244b3b;
}
.recipe-initial {
  font-size: 100rpx;
  font-weight: 500;
}
.recipe-caption {
  font-size: 23rpx;
  letter-spacing: 5rpx;
  opacity: 0.6;
}
.recipe-heading {
  padding: 32rpx 0 8rpx;
}
.recipe-heading .title {
  margin-bottom: 20rpx;
}
.recipe-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.ingredient {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(36, 75, 59, 0.06);
}
.ingredient-dot {
  color: #244b3b;
  font-size: 30rpx;
}
.allergy {
  border-top: 1rpx solid rgba(36, 75, 59, 0.08);
  margin-top: 24rpx;
  padding-top: 24rpx;
  font-size: 26rpx;
}
.allergy-title {
  font-weight: 600;
  color: #be6345;
  margin-bottom: 8rpx;
}
.allergy .muted {
  margin-top: 12rpx;
  font-size: 23rpx;
}
.recipe-step {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  line-height: 1.8;
}
.step-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  background: rgba(36, 75, 59, 0.07);
  color: #244b3b;
  font-size: 24rpx;
  flex-shrink: 0;
}
.recipe-footer {
  text-align: center;
  padding: 24rpx 0;
  font-size: 23rpx;
}
