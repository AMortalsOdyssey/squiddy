.dish-detail {
  padding-top: 16rpx;
}
.recipe-cover {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
  display: block;
}
.recipe-placeholder {
  background: rgba(36, 75, 59, 0.07);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #244b3b;
  height: 112rpx;
}
.recipe-initial {
  font-size: 44rpx;
  font-weight: 500;
}
.recipe-caption {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  opacity: 0.6;
}
.recipe-heading {
  padding: 24rpx 0 8rpx;
}
.recipe-heading .title {
  margin-bottom: 14rpx;
}
.recipe-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.ingredient {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(36, 75, 59, 0.06);
}
.ingredient-dot {
  color: #244b3b;
  font-size: 28rpx;
}
.allergy {
  border-top: 1rpx solid rgba(36, 75, 59, 0.08);
  margin-top: 16rpx;
  padding-top: 16rpx;
  font-size: 24rpx;
}
.allergy-title {
  font-weight: 600;
  color: #be6345;
  margin-bottom: 8rpx;
}
.allergy .muted {
  margin-top: 8rpx;
  font-size: 22rpx;
}
.recipe-step {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  line-height: 1.6;
}
.step-number {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  background: rgba(36, 75, 59, 0.07);
  color: #244b3b;
  font-size: 22rpx;
  flex-shrink: 0;
}
.recipe-footer {
  text-align: center;
  padding: 16rpx 0;
  font-size: 22rpx;
}
