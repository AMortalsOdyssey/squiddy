<view class="page with-dock"><view wx:if="{{local}}" class="local-banner">本地演练 · 收藏与想吃记录只留在本机</view><view class="eyebrow">给下一顿找点灵感</view><view class="title">家常菜谱库</view><view class="muted">鱿鱼须须编写的家常做法，免费收藏与导入。导入后请按自家用料核对食材和过敏原。</view><button wx:if="{{canImport||!hasKitchen}}" class="link-button" bindtap="manual">＋ 记自己的拿手菜</button><button wx:if="{{canImport}}" class="link-button" bindtap="fromShare">从分享文字整理食谱</button><view wx:if="{{error}}" class="note">{{error}}</view><input class="input" value="{{search}}" bindinput="input" placeholder="找菜名、口味或食材"/><scroll-view scroll-x class="category-scroll"><view class="category-strip"><view wx:for="{{categories}}" wx:key="id" class="category-chip {{category===item.id?'active':''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</view></view></scroll-view><view class="segmented"><view class="segment {{panel==='all'?'active':''}}" data-id="all" bindtap="panel">全部菜谱</view><view class="segment {{panel==='favorites'?'active':''}}" data-id="favorites" bindtap="panel">我的收藏</view><view wx:if="{{hasKitchen}}" class="segment {{panel==='wishes'?'active':''}}" data-id="wishes" bindtap="panel">朋友想吃</view></view><view wx:if="{{!loading&&!visible.length&&!error}}" class="empty">{{panel==='favorites'?'点一下喜欢的菜，先替下一顿存着。':panel==='wishes'?'朋友点「想吃」，就会出现在这里。':'换个词或分类看看。'}}</view><view class="card" wx:for="{{visible}}" wx:key="id"><view class="row"><view class="recipe-mark" data-id="{{item.id}}" bindtap="expand">{{item.name[0]}}</view><view class="flex" data-id="{{item.id}}" bindtap="expand"><view class="dish-name">{{item.name}}</view><view class="muted">{{item.subtitle}}</view><view class="recipe-meta">{{item.category_name}} · {{item.minutes}} 分钟 {{item.wish_count?'· '+item.wish_count+'位朋友想吃':''}}</view></view><button size="mini" class="favorite-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="favorite" aria-label="{{item.favorite?'取消收藏':'收藏'}}{{item.name}}">{{item.favorite?'♥':'♡'}}</button></view><view wx:if="{{expanded===item.id}}" class="recipe-detail"><view class="label">食材</view><view>{{item.ingredientsText}}</view><view class="label">做法</view><text class="steps">{{item.steps}}</text><view class="muted" wx:if="{{item.allergens.length}}">含过敏原提示：{{item.allergensText}}</view></view><view class="row recipe-actions"><button wx:if="{{canImport}}" class="secondary" disabled="{{busy||item.in_kitchen}}" data-id="{{item.id}}" bindtap="select">{{item.in_kitchen?'已在厨房':item.selected?'✓ 已选，点此取消':'选入厨房'}}</button><button wx:if="{{hasKitchen}}" class="secondary" disabled="{{busy||item.in_kitchen}}" data-id="{{item.id}}" bindtap="wish">{{item.in_kitchen?'厨房已备好':item.wished?'♥ 想吃，点此取消':'想吃这道'}}</button></view></view><view wx:if="{{!hasKitchen&&!loading}}" class="card"><view class="muted">先收藏喜欢的菜，创建厨房后就能导入和邀请朋友。</view><button class="primary" bindtap="create">创建我的厨房</button></view></view><view wx:if="{{canImport}}" class="action-dock"><view class="dock-copy"><view class="dock-count">已选 {{selected.length}} 道</view><view class="muted">导入不改变已发布饭局</view></view><button class="primary dock-action" disabled="{{busy||!selected.length}}" loading="{{busy}}" bindtap="importSelected">加入厨房</button></view>
