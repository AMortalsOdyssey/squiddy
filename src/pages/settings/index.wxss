.privacy-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 68rpx;
}
.privacy-head .muted {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.paragraph {
  margin: 16rpx 0 8rpx;
  line-height: 1.65;
  font-size: 24rpx;
  white-space: pre-wrap;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(36, 75, 59, 0.08);
}
.privacy-demo {
  font-size: 22rpx;
  margin-top: 14rpx;
}
.export {
  height: 320rpx;
  word-break: break-all;
  font-size: 21rpx;
  background: rgba(36, 75, 59, 0.04);
  border-radius: 12rpx;
  padding: 14rpx;
  margin-top: 14rpx;
}
.export-ready {
  font-size: 24rpx;
  color: #244b3b;
  margin-top: 20rpx;
}
.feedback-receipt {
  font-size: 22rpx;
  color: rgba(36, 51, 43, 0.6);
  margin-top: 14rpx;
  word-break: break-all;
}
.account-removal {
  border: 1rpx solid rgba(190, 99, 69, 0.1);
}
.account-removal .text-danger {
  margin-bottom: 0;
}

.feedback-record{border-top:1rpx solid rgba(36,75,59,.1);padding-top:16rpx;margin-top:16rpx;word-break:break-word;font-size:24rpx;line-height:1.6}
