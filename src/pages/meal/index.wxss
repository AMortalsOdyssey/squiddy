.deadline {
  margin-top: 20rpx;
}
.request {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(36, 75, 59, 0.08);
}
.request:last-child {
  border-bottom: 0;
}
.portion-input {
  width: 120rpx;
  background: #f6f3eb;
  padding: 16rpx;
  text-align: center;
  border-radius: 16rpx;
}
.quote-total {
  font-size: 48rpx;
  font-weight: 600;
  color: #244b3b;
}
.status-line {
  margin-top: 16rpx;
  color: #657168;
}
.title {
  font-size: 44rpx;
}
