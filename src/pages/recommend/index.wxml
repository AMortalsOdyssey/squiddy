<view class="page"
  ><view wx:if="{{local}}" class="local-banner"
    >本地演练 · 根据本机菜谱搭配</view
  ><view class="eyebrow">不用纠结，给你几种好搭配</view
  ><view class="title">帮我搭一桌</view
  ><view class="card"
    ><view class="form-row"
      ><text>几个人吃</text
      ><input
        class="number-input"
        type="number"
        maxlength="2"
        value="{{people}}"
        data-field="people"
        bindinput="input" /></view
    ><view class="label">喜欢的食材（可选）</view
    ><input
      class="input"
      value="{{likes}}"
      data-field="likes"
      bindinput="input"
      placeholder="例如：番茄、鸡蛋"
    /><view class="form-row"
      ><text>单道菜最长几分钟</text
      ><input
        class="number-input"
        type="number"
        value="{{maxMinutes}}"
        data-field="maxMinutes"
        bindinput="input" /></view
    ><view class="label">不吃什么 / 过敏原</view
    ><input
      class="input"
      placeholder="例如：花生、虾、牛奶"
      value="{{avoid}}"
      data-field="avoid"
      bindinput="input"
    /><view class="form-row"
      ><text>只选素食</text
      ><switch
        checked="{{vegetarian}}"
        data-field="vegetarian"
        bindchange="toggle"
        color="#244B3B" /></view
    ><view class="form-row"
      ><text>不要辣</text
      ><switch
        checked="{{mild}}"
        data-field="mild"
        bindchange="toggle"
        color="#244B3B" /></view
    ><button
      class="primary"
      bindtap="generate"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      换几套搭配
    </button></view
  ><view wx:if="{{message}}" class="note">{{message}}</view>
  <view class="card" wx:for="{{plans}}" wx:key="id" wx:for-index="planIndex"
    ><view class="dish-name">{{item.name}}</view
    ><view class="muted">{{item.reason}}</view
    ><view
      class="form-row"
      wx:for="{{item.items}}"
      wx:key="dish_id"
      wx:for-item="dish"
      ><text>{{dish.name}}</text><text>{{dish.quantity}}份</text></view
    ><view class="muted">{{item.warning}}</view
    ><button
      class="primary"
      data-index="{{planIndex}}"
      data-direct="{{true}}"
      bindtap="use"
      disabled="{{busy}}"
    >
      就吃这套（替换当前待选），直接提交</button
    ><button
      class="secondary"
      data-index="{{planIndex}}"
      data-direct="{{false}}"
      bindtap="use"
      disabled="{{busy}}"
    >
      整套加入，再看看
    </button></view
  ></view
>
