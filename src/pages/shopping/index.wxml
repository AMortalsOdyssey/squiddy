<view class="page">
 <view wx:if="{{local}}" class="local-banner">本地演练 · 不代表真实多人协作</view>
 <view class="eyebrow">一桌好饭，从备齐食材开始。</view><view class="title">购物清单</view>
 <view wx:if="{{loading}}" class="empty">正在整理清单…</view><view wx:elif="{{error}}" class="card"><view>{{error}}</view><button class="secondary" bindtap="refresh">重新加载</button></view>
 <block wx:elif="{{list}}"><view class="muted">同餐朋友可勾选和认领。下拉刷新查看最新进度，采购量由大家手动确认。</view><view wx:if="{{list.stale}}" class="note">制作计划已有变化，这份清单可能过时，请接单厨师按最新计划更新。</view><view class="row actions"><button wx:if="{{list.can_generate}}" class="secondary" bindtap="generate" disabled="{{busy||!list.can_change}}">按制作计划更新</button><button class="primary" bindtap="add" disabled="{{busy||!list.can_change}}">补充采购</button></view>
 <view wx:if="{{!list.can_change}}" class="note">本餐已经取消，清单仅供回看。</view>
 <view wx:if="{{!list.generated}}" class="note">主厨确认实际制作计划后，可以按菜谱食材生成清单。现在也能手动补充。</view>
 <view wx:if="{{editing}}" class="card"><view class="section-title">{{editing==='new'?'补充采购':'编辑采购'}}</view><view class="label">食材名称</view><input class="input" value="{{name}}" maxlength="80" data-field="name" bindinput="input" placeholder="例如：鸡蛋"/><view class="label">采购量</view><input class="input" value="{{amount}}" maxlength="40" data-field="amount" bindinput="input" placeholder="手动填写，例如：6个"/><view class="label">采购备注</view><textarea class="textarea" value="{{note}}" maxlength="100" data-field="note" bindinput="input" placeholder="例如：家里已有，先不用买"/><view class="row"><button class="secondary" bindtap="cancel">取消</button><button class="primary" bindtap="save" disabled="{{busy||!list.can_change}}" loading="{{busy}}">保存</button></view></view>
 <view wx:if="{{!list.items.length}}" class="card empty">清单还空着，先写下需要的食材吧。</view>
 <view class="card purchase {{item.checked?'purchased':''}}" wx:for="{{list.items}}" wx:key="id"><view class="row"><button size="mini" class="check-button" aria-label="{{item.checked?'标记未买':'标记已买'}}{{item.name}}" data-id="{{item.id}}" bindtap="check" disabled="{{busy||!list.can_change}}"><text class="check-symbol">{{item.checked?'✓':'○'}}</text></button><view class="flex"><view class="dish-name">{{item.name}}</view><view class="muted">{{item.amount||'用量待确认'}}{{item.manual?' · 手动补充':''}}</view></view><text class="tag">{{item.checked?'已备齐':'待采购'}}</text></view><view wx:if="{{item.note}}" class="purchase-note">{{item.note}}</view><view class="muted source" wx:for="{{item.sources}}" wx:for-item="source" wx:key="line_id">用于 {{source.name}} · 实际做 {{source.quantity}} 份</view><view class="row purchase-actions"><view class="muted flex">{{item.claimed_name?item.claimed_name+' 已认领':'还没人认领'}}</view><button wx:if="{{!item.claimed_name||item.can_release}}" class="link-button" data-id="{{item.id}}" bindtap="claim" disabled="{{busy||!list.can_change}}">{{item.claimed_name?'取消认领':'我来买'}}</button><button wx:if="{{item.can_edit}}" class="link-button" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{item.can_edit}}" class="link-button" data-id="{{item.id}}" bindtap="remove" disabled="{{busy||!list.can_change}}">移除</button></view></view>
 </block>
</view>
