{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "miniprogram",
    "types": [
      "miniprogram-api-typings"
    ],
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
