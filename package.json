{
  "name": "squiddy",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run doctor",
    "setup:cloud": "node scripts/install-cloud.mjs",
    "prepare:cloud": "npm run build && node scripts/prepare-cloud.mjs",
    "audit:all": "node scripts/audit.mjs",
    "backup:run": "node scripts/backup-run.cjs run",
    "backup:status": "node scripts/backup-run.cjs status",
    "health:cloud": "node scripts/health.cjs"
  },
  "devDependencies": {
    "miniprogram-api-typings": "5.2.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
